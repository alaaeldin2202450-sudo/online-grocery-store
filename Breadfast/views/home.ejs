<!DOCTYPE html>
<html lang="en">
  <%- include("./components/headTag.ejs") %>
  <head>
    <link rel="stylesheet" href="/css/home.css" />
    <link rel="stylesheet" href="/css/products.css" />
  </head>
  <body>
    <%- include("./components/navbar.ejs") %>

    <main class="hero-section">
      <div class="hero-overlay"></div>
      <div class="hero-container container">
        <div class="hero-copy">
          <span class="eyebrow">Fresh groceries, delivered fast</span>
          <h1>Modern online grocery shopping made simple.</h1>
          <p>
            Shop <%= totalProducts.toLocaleString() %>+ products with real-time data from your MongoDB database —
            names, prices, stock, and images.
          </p>

          <div class="hero-actions">
            <form class="search-box" action="/" method="get">
              <input type="text" name="search" placeholder="Search for bread, milk, fruits..." value="<%= search || '' %>" />
              <button class="btn btn-primary" type="submit">Search</button>
            </form>
            <a href="#products" class="btn btn-light hero-shop-btn">Browse products</a>
            <div class="location-chip">Delivering to <strong>Cairo</strong></div>
          </div>

          <div class="hero-badges">
            <div class="badge-item">
              <i class="fa-solid fa-truck-fast"></i>
              <span>Fast delivery</span>
            </div>
            <div class="badge-item">
              <i class="fa-solid fa-leaf"></i>
              <span>Fresh products</span>
            </div>
            <div class="badge-item">
              <i class="fa-solid fa-database"></i>
              <span>MongoDB live data</span>
            </div>
          </div>
        </div>

        <div class="hero-cards">
          <div class="hero-card">
            <h3>Order online</h3>
            <p>Find everything you need in one place and get it delivered today.</p>
          </div>
          <div class="hero-card highlight-card">
            <h3><%= totalProducts.toLocaleString() %> products</h3>
            <p>Your full grocery catalog is connected and ready to shop.</p>
          </div>
        </div>
      </div>
    </main>

    <section class="features-section container">
      <div class="section-header center">
        <h2>Why shop with Breadfast?</h2>
        <p>Smart groceries built for modern online shopping.</p>
      </div>

      <div class="features-grid">
        <article class="feature-card">
          <i class="fa-solid fa-clock"></i>
          <h3>Fast delivery</h3>
          <p>Track your order and get updates from store to doorstep.</p>
        </article>
        <article class="feature-card">
          <i class="fa-solid fa-mobile-screen-button"></i>
          <h3>No phone calls</h3>
          <p>Order directly from the website without extra steps.</p>
        </article>
        <article class="feature-card discount-card">
          <i class="fa-solid fa-percent"></i>
          <h3>New customer offer</h3>
          <p>Use code <strong>FIRST10</strong> and get 30 EGP off your first order.</p>
        </article>
      </div>
    </section>

    <%- include("./partials/productGrid.ejs", { baseUrl: '/' }) %>

    <script type="module">
      import Toastify from "/js/toastify.js";
      document.addEventListener("DOMContentLoaded", () => {
        const addToCartButtons = document.querySelectorAll(".add-to-cart");

        addToCartButtons.forEach((button) => {
          button.addEventListener("click", async (e) => {
            const productId = e.currentTarget.getAttribute("data-product-id");
            const pathParts = window.location.pathname.split("/");
            const userId = pathParts.length > 2 ? pathParts[2] : null;

            if (!userId) {
              const redirectTo = encodeURIComponent(window.location.pathname + window.location.search);
              window.location.href = `/signin?redirect=${redirectTo}`;
              return;
            }

            const response = await fetch("/cart/add", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ userId, productId, quantity: 1 }),
            });

            if (response.status === 200) {
              Toastify("Product added successfully.", "green");
              setTimeout(() => location.reload(), 700);
            } else {
              const json = await response.json().catch(() => ({}));
              Toastify(json.message || "Something went wrong.", "red");
            }
          });
        });
      });
    </script>
  </body>
</html>
