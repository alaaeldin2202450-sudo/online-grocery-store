<!DOCTYPE html>
<html lang="en">
  <%- include("../components/headTag.ejs") %>
  <head>
    <link rel="stylesheet" href="/css/user.css" />
    <link rel="stylesheet" href="/css/products.css" />
    <style>
      .custom-offcanvas {
        width: 420px !important;
        max-width: 100% !important;
      }
    </style>
  </head>
  <body>
    <%- include("./components/navbar.ejs") %>

    <div class="container user-dashboard">
      <header class="dashboard-header">
        <div>
          <p class="welcome-label">Welcome back</p>
          <h1>Hi <%= user.name ? user.name : 'Shopper' %>, ready to shop?</h1>
          <p>Browse <%= totalProducts.toLocaleString() %> fresh groceries and add what you need to your cart in one click.</p>
        </div>
        <button class="btn btn-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasRight" aria-controls="offcanvasRight">
          View cart (<%= user.cart.items ? user.cart.items.length : 0 %>)
        </button>
      </header>
    </div>

    <%- include("../partials/productGrid.ejs", { baseUrl: '/user/' + user.id }) %>

    <div class="offcanvas offcanvas-end custom-offcanvas" tabindex="-1" id="offcanvasRight" aria-labelledby="offcanvasRightLabel">
      <div class="offcanvas-header">
        <h2 class="offcanvas-title" id="offcanvasRightLabel">Your cart</h2>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
      </div>
      <div class="offcanvas-body">
        <% if (user.cart.items && user.cart.items.length > 0) { %>
        <div class="cart-summary">
          <div class="cart-info">
            <p><strong><%= user.cart.items.length %> items</strong></p>
            <p>Total: <strong><%= user.cart.totalPrice.toFixed(2) %></strong></p>
          </div>
          <% user.cart.items.forEach(item => { %>
          <div class="cart-item">
            <img src="<%= item.product.imageUrl %>" alt="<%= item.product.name %>" loading="lazy" referrerpolicy="no-referrer" />
            <div class="cart-item-details">
              <p class="cart-item-name"><%= item.product.name %></p>
              <p class="cart-item-meta">Qty: <%= item.quantity %> • <%= item.price.toFixed(2) %></p>
            </div>
          </div>
          <% }); %>
          <a href="/user/<%= user.id %>/payment" class="btn btn-success w-100 mt-3">Proceed to payment</a>
        </div>
        <% } else { %>
        <div class="empty-cart">
          <p>Your cart is empty.</p>
          <p>Browse the products and add items to start shopping.</p>
        </div>
        <% } %>
      </div>
    </div>

    <script type="module">
      import Toastify from "/js/toastify.js";
      document.addEventListener("DOMContentLoaded", () => {
        const addToCartButtons = document.querySelectorAll(".add-to-cart");

        addToCartButtons.forEach((button) => {
          button.addEventListener("click", async (e) => {
            const productId = e.currentTarget.getAttribute("data-product-id");
            const userId = window.location.pathname.split("/")[2];

            const response = await fetch("/cart/add", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ userId, productId, quantity: 1 }),
            });

            if (response.status === 200) {
              Toastify("Product added successfully.", "green");
              setTimeout(() => location.reload(), 700);
            } else {
              const json = await response.json().catch(() => ({}));
              Toastify(json.message || "Something went wrong.", "red");
            }
          });
        });
      });
    </script>
  </body>
</html>
