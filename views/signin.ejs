<!DOCTYPE html>
<html lang="en">
  <%- include("./components/headTag.ejs") %>
  <head>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');
      
      body {
        font-family: 'Poppins', sans-serif;
        background: linear-gradient(-45deg, #f3e5ff, #e6f0ff, #ffffff, #f9f2ff);
        background-size: 400% 400%;
        animation: gradientBG 15s ease infinite;
        min-height: 100vh;
        margin: 0;
      }

      @keyframes gradientBG {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
      }

      .auth-container {
        animation: slideUpFade 0.6s ease-out forwards;
        background: rgba(255, 255, 255, 0.95);
        border-radius: 24px;
        box-shadow: 0 15px 35px rgba(155, 49, 249, 0.1);
        border: 1px solid rgba(255,255,255,0.8);
        padding: 40px;
        width: 100%;
        max-width: 500px;
      }

      @keyframes slideUpFade {
        from {
          opacity: 0;
          transform: translateY(30px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      h1 {
        font-weight: 700;
        color: #333;
        margin-bottom: 30px;
      }

      .form-label {
        font-weight: 500;
        color: #555;
      }

      .form-control {
        border-radius: 12px;
        padding: 12px 15px;
        border: 1px solid #ddd;
        transition: all 0.3s;
      }

      .form-control:focus {
        border-color: #9b31f9;
        box-shadow: 0 0 0 4px rgba(155, 49, 249, 0.1);
      }

      .btn-primary {
        background: linear-gradient(135deg, #9b31f9, #7000cc);
        border: none;
        border-radius: 12px;
        padding: 12px 30px;
        font-weight: 600;
        transition: transform 0.3s, box-shadow 0.3s;
      }

      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(155, 49, 249, 0.3);
      }

      .btn-secondary {
        border-radius: 12px;
        padding: 12px 30px;
        font-weight: 600;
      }
      
      a {
        color: #9b31f9;
        text-decoration: none;
        font-weight: 500;
        transition: color 0.3s;
      }
      
      a:hover {
        color: #7000cc;
        text-decoration: underline;
      }

      @media (max-width: 768px) {
        .auth-container {
          padding: 30px 20px;
        }
        h1 {
          font-size: 28px;
        }
        .btn-primary, .btn-secondary {
          padding: 12px 15px;
          font-size: 14px;
        }
      }
    </style>
  </head>
  <body>
    <%- include("./components/navbar.ejs") %>
    <div
      class="d-flex justify-content-center align-items-center"
      style="min-height: calc(100vh - 80px);"
    >
      <div class="auth-container m-3">
        <form id="loginForm" style="color: black">
          <h1 class="text-center">Sign in</h1>

          <!-- Email Field -->
          <div class="mb-4">
            <label for="email" class="form-label">Email Address</label>
            <input
              type="text"
              class="form-control"
              id="email"
              placeholder="Enter your email"
            />
          </div>

          <!-- Password Field -->
          <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input
              type="password"
              class="form-control"
              id="password"
              placeholder="Enter your password"
            />
          </div>

          <!-- Forgot Password Link -->
          <div class="mb-4 text-end">
            <a href="/forgot-password">Forgot Password?</a>
          </div>

          <!-- Buttons -->
          <div class="d-flex justify-content-between">
            <button type="submit" class="btn btn-primary w-100 me-2">Sign In</button>
            <button type="button" class="btn btn-secondary w-100 ms-2" onclick="window.location.href='/'">Cancel</button>
          </div>
          
          <div class="mt-4 text-center">
            <p style="color: #666;">Don't have an account? <a href="/signup">Sign up</a></p>
          </div>
        </form>
      </div>
    </div>

    <script type="module">
      import Toastify from "./js/toastify.js";

      document
        .getElementById("loginForm")
        .addEventListener("submit", async (event) => {
          event.preventDefault();

          const email = document.getElementById("email").value;
          const password = document.getElementById("password").value;

          let valid = true;

          if (email.trim() === "") {
            valid = false;
            return Toastify("Email is required.", "red");
          } else if (!/\S+@\S+\.\S+/.test(email)) {
            valid = false;
            return Toastify("Please enter a valid email address.", "red");
          }

          if (password.trim() === "") {
            valid = false;
            return Toastify("Password is required.", "red");
          }

          try {
            const response = await fetch("/users/signin", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify({
                email,
                password,
              }),
            });

            const data = await response.json();

            if (response.ok) {
              Toastify("sign in successful!", "green");
              if (data.user.role == "user")
                window.location.href = `/${data.user.role}/${data.user.id}`;
              else window.location.href = `/${data.user.role}`;
            } else {
              Toastify(data.error || "Wrong email or password.", "red");
            }
          } catch (error) {
            Toastify("An error occurred: " + error.message, "red");
          }
        });
    </script>
  </body>
</html>
