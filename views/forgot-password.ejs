<!DOCTYPE html>
<html lang="en">
  <%- include("./components/headTag.ejs") %>
  <head>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');
      
      body {
        font-family: 'Poppins', sans-serif;
        background: linear-gradient(-45deg, #f3e5ff, #e6f0ff, #ffffff, #f9f2ff);
        background-size: 400% 400%;
        animation: gradientBG 15s ease infinite;
        min-height: 100vh;
        margin: 0;
      }

      @keyframes gradientBG {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
      }

      .auth-container {
        animation: slideUpFade 0.6s ease-out forwards;
        background: rgba(255, 255, 255, 0.95);
        border-radius: 24px;
        box-shadow: 0 15px 35px rgba(155, 49, 249, 0.1);
        border: 1px solid rgba(255,255,255,0.8);
        padding: 40px;
        width: 100%;
        max-width: 500px;
      }

      @keyframes slideUpFade {
        from {
          opacity: 0;
          transform: translateY(30px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      h1 {
        font-weight: 700;
        color: #333;
        margin-bottom: 20px;
      }
      
      p.subtitle {
        color: #666;
        margin-bottom: 30px;
        text-align: center;
      }

      .form-label {
        font-weight: 500;
        color: #555;
      }

      .form-control {
        border-radius: 12px;
        padding: 12px 15px;
        border: 1px solid #ddd;
        transition: all 0.3s;
      }

      .form-control:focus {
        border-color: #9b31f9;
        box-shadow: 0 0 0 4px rgba(155, 49, 249, 0.1);
      }

      .btn-primary {
        background: linear-gradient(135deg, #9b31f9, #7000cc);
        border: none;
        border-radius: 12px;
        padding: 12px 30px;
        font-weight: 600;
        transition: transform 0.3s, box-shadow 0.3s;
      }

      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(155, 49, 249, 0.3);
      }
      
      a {
        color: #9b31f9;
        text-decoration: none;
        font-weight: 500;
        transition: color 0.3s;
      }
      
      a:hover {
        color: #7000cc;
        text-decoration: underline;
      }

      @media (max-width: 768px) {
        .auth-container {
          padding: 30px 20px;
        }
        h1 {
          font-size: 28px;
        }
        .btn-primary, .btn-secondary {
          padding: 12px 15px;
          font-size: 14px;
        }
      }
    </style>
  </head>
  <body>
    <%- include("./components/navbar.ejs") %>
    <div
      class="d-flex justify-content-center align-items-center"
      style="min-height: calc(100vh - 80px);"
    >
      <div class="auth-container m-3">
        <form id="forgotPasswordForm" style="color: black">
          <h1 class="text-center">Forgot Password?</h1>
          <p class="subtitle">Enter your email address and we will send you a link to reset your password.</p>

          <!-- Email Field -->
          <div class="mb-4">
            <label for="email" class="form-label">Email Address</label>
            <input
              type="text"
              class="form-control"
              id="email"
              placeholder="Enter your email"
            />
          </div>

          <!-- Buttons -->
          <div class="d-flex justify-content-center mb-4">
            <button type="submit" class="btn btn-primary w-100">Send Reset Link</button>
          </div>
          
          <div class="text-center">
            <a href="/signin"><i class="fa-solid fa-arrow-left"></i> Back to Sign in</a>
          </div>
        </form>
      </div>
    </div>

    <script type="module">
      import Toastify from "./js/toastify.js";

      document
        .getElementById("forgotPasswordForm")
        .addEventListener("submit", (event) => {
          event.preventDefault();

          const email = document.getElementById("email").value;

          if (email.trim() === "") {
            return Toastify("Email is required.", "red");
          } else if (!/\S+@\S+\.\S+/.test(email)) {
            return Toastify("Please enter a valid email address.", "red");
          }

          // Simulate sending email
          Toastify("If the email exists, a reset link will be sent.", "green");
          setTimeout(() => {
            window.location.href = "/signin";
          }, 2000);
        });
    </script>
  </body>
</html>
