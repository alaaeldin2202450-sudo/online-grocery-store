<!DOCTYPE html>
<html lang="en">
  <%- include("../components/headTag.ejs") %>
  <head>
    <link rel="stylesheet" href="/css/user.css" />
    <style>
      .custom-offcanvas {
        width: 500px !important;
      }
    </style>
  </head>
  <body>
    <%- include("./components/navbar.ejs") %>

    <div class="container">
      <div id="content" class="my-5">
        <div id="filterbar">
          <div class="box border-bottom">
            <div class="form-group text-center d-flex gap-2 justify-content-center">
              <button type="button" id="resetFilters" class="btn btn-outline-success">
                Reset
              </button>
              <button type="button" id="applyFilters" class="btn btn-success">
                Apply
              </button>
            </div>
          </div>
          <div class="box border-bottom">
            <div class="box-label text-uppercase d-flex align-items-center">
              Categories
              <button class="btn ml-auto" type="button">
                <span class="fas fa-plus"></span>
              </button>
            </div>
            <div class="mt-2 mr-1">
              <div class="my-1">
                <label class="tick">
                  Bakeries & Pastries<input type="checkbox" class="category-filter" value="Bakeries & Pastries" />
                  <span class="check"></span>
                </label>
              </div>
              <div class="my-1">
                <label class="tick">
                  Dairy<input type="checkbox" class="category-filter" value="Dairy" />
                  <span class="check"></span>
                </label>
              </div>
              <div class="my-1">
                <label class="tick">
                  Fruits and Veggies<input type="checkbox" class="category-filter" value="Fruits and Veggies" />
                  <span class="check"></span>
                </label>
              </div>
              <div class="my-1">
                <label class="tick">
                  Snacks<input type="checkbox" class="category-filter" value="Snacks" />
                  <span class="check"></span>
                </label>
              </div>
              <div class="my-1">
                <label class="tick">
                  Behind the Counter<input type="checkbox" class="category-filter" value="Behind the Counter" />
                  <span class="check"></span>
                </label>
              </div>
              <div class="my-1">
                <label class="tick">
                  Beverages<input type="checkbox" class="category-filter" value="Beverages" />
                  <span class="check"></span>
                </label>
              </div>
              <div class="my-1">
                <label class="tick">
                  Beauty Essentials<input type="checkbox" class="category-filter" value="Beauty Essentials" />
                  <span class="check"></span>
                </label>
              </div>
            </div>
          </div>
        </div>
        <div id="products">
          <% if (products && products.length > 0) { %>
          <div class="row mx-0">
            <% products.forEach(product => { %>
            <div class="col-md-4 product-card" data-category="<%= product.category %>">
              <div class="bbb_deals_slider_container">
                <div class="bbb_deals_item">
                  <div class="bbb_deals_image">
                    <img src="<%= product.imageUrl %>" alt="" />
                  </div>
                  <div class="bbb_deals_content">
                    <div
                      class="bbb_deals_info_line d-flex flex-row justify-content-start"
                    >
                      <div class="bbb_deals_item_category">
                        <a href="#"><%= product.category %></a>
                      </div>
                    </div>
                    <div class="bbb_deals_item_name"><%= product.name %></div>
                    <div class="bbb_deals_item_price ml-auto">
                      <%= product.price %> EGP
                    </div>
                    <div class="available">
                      <div
                        class="available_line d-flex flex-row justify-content-start"
                      >
                        <div class="available_title">
                          Available: <span><%= product.quantity %></span>
                        </div>
                      </div>
                      <div class="available_bar">
                        <span style="width: 17%"></span>
                      </div>
                      <div class="mt-3">
                        <button
                          class="btn btn-secondary add-to-cart"
                          data-product-id="<%= product._id %>"
                        >
                          Add to cart
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <% }); %>
          </div>
          <p id="noFilterResults" style="display: none;" class="text-muted mt-3">
            No products match the selected categories.
          </p>
          <% } else { %>
          <p>No products available</p>
          <% } %>
        </div>
      </div>
    </div>

    <div
      class="offcanvas offcanvas-end custom-offcanvas"
      tabindex="-1"
      id="offcanvasRight"
      aria-labelledby="offcanvasRightLabel"
    >
      <div class="offcanvas-header">
        <h2 class="offcanvas-title" id="offcanvasRightLabel">Cart</h2>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="offcanvas"
          aria-label="Close"
        ></button>
      </div>
      <div class="offcanvas-body">
        <% if (user.cart.items && user.cart.items.length > 0) { %>
        <div class="cart">
          <div class="title">
            <div class="col align-self-center text-right text-muted">
              <%= user.cart.items.length %> items
            </div>
          </div>
          <% user.cart.items.forEach(item => { %>
          <div class="row border-top border-bottom align-items-center">
            <!-- Product Image -->
            <div class="col-3">
              <img class="img-fluid" src="<%= item.product.imageUrl %>" />
            </div>

            <!-- Product Description -->
            <div class="col-3">
              <p class="text-nowrap"><%= item.product.name %></p>
            </div>

            <!-- Quantity Controls -->
            <div class="col-3">
              <div class="d-flex align-items-center">
                <button
                  type="button"
                  class="btn btn-success cart-increase"
                  data-product-id="<%= item.product._id %>"
                  data-quantity="<%= item.quantity %>"
                >
                  +
                </button>
                <span class="mx-2 cart-qty"><%= item.quantity %></span>
                <button
                  type="button"
                  class="btn btn-danger cart-decrease"
                  data-product-id="<%= item.product._id %>"
                  data-quantity="<%= item.quantity %>"
                >
                  -
                </button>
              </div>
            </div>

            <!-- Price and Remove Button -->
            <div class="col-3">
              <p><%= item.price %> EGP</p>
            </div>
          </div>
          <% }); %>
          <div class="title d-flex align-items-center mt-3">
            <a href="/user/<%=user.id%>/payment" class="btn btn-success"
              >Process payment</a
            >
            <div class="col align-self-center text-right text-muted">
              Total : <%= user.cart.totalPrice %> EGP
            </div>
          </div>
        </div>
        <% } else { %>
        <p>No products available</p>
        <% } %>
      </div>
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const userId = window.location.pathname.split("/")[2];
        const productCards = document.querySelectorAll(".product-card");
        const categoryFilters = document.querySelectorAll(".category-filter");
        const applyBtn = document.getElementById("applyFilters");
        const resetBtn = document.getElementById("resetFilters");
        const noProductsMsg = document.getElementById("noFilterResults");

        const showToast = (message, color) => {
          Toastify({
            text: message,
            duration: 3000,
            gravity: "top",
            position: "right",
            stopOnFocus: true,
            backgroundColor: color,
          }).showToast();
        };

        const applyCategoryFilter = () => {
          const selected = Array.from(categoryFilters)
            .filter((cb) => cb.checked)
            .map((cb) => cb.value);

          if (selected.length === 0) {
            showToast("Choose at least one category.", "orange");
            return;
          }

          let visibleCount = 0;

          productCards.forEach((card) => {
            const visible = selected.includes(card.dataset.category);
            card.style.display = visible ? "" : "none";
            if (visible) visibleCount += 1;
          });

          if (noProductsMsg) {
            noProductsMsg.style.display = visibleCount === 0 ? "block" : "none";
          }

          showToast(`Showing ${visibleCount} product(s).`, "green");
        };

        const resetCategoryFilter = () => {
          categoryFilters.forEach((cb) => {
            cb.checked = false;
          });

          productCards.forEach((card) => {
            card.style.display = "";
          });

          if (noProductsMsg) {
            noProductsMsg.style.display = "none";
          }

          showToast("Filters reset.", "green");
        };

        applyBtn.addEventListener("click", applyCategoryFilter);
        resetBtn.addEventListener("click", resetCategoryFilter);

        categoryFilters.forEach((cb) => {
          cb.addEventListener("change", () => {
            if (Array.from(categoryFilters).some((item) => item.checked)) {
              applyCategoryFilter();
            }
          });
        });

        const updateCartQuantity = async (productId, quantity) => {
          const response = await fetch("/cart/update", {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ userId, productId, quantity }),
          });

          const result = await response.json();

          if (response.ok) {
            showToast(result.message || "Cart updated.", "green");
            setTimeout(() => {
              location.reload();
            }, 1000);
          } else {
            showToast(result.message || "Could not update cart.", "red");
          }
        };

        document.querySelectorAll(".add-to-cart").forEach((button) => {
          button.addEventListener("click", async () => {
            const productId = button.getAttribute("data-product-id");

            if (!productId || !userId) {
              return showToast("Missing product or user.", "red");
            }

            try {
              const response = await fetch("/cart/add", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ userId, productId, quantity: 1 }),
              });

              const result = await response.json();

              if (response.ok) {
                showToast("Product added successfully.", "green");
                setTimeout(() => {
                  location.reload();
                }, 1000);
              } else {
                showToast(result.message || "Something went wrong.", "red");
              }
            } catch (error) {
              showToast("An error occurred: " + error.message, "red");
            }
          });
        });

        document.querySelectorAll(".cart-increase").forEach((button) => {
          button.addEventListener("click", async () => {
            const productId = button.dataset.productId;
            const quantity = Number(button.dataset.quantity) + 1;
            await updateCartQuantity(productId, quantity);
          });
        });

        document.querySelectorAll(".cart-decrease").forEach((button) => {
          button.addEventListener("click", async () => {
            const productId = button.dataset.productId;
            const quantity = Number(button.dataset.quantity) - 1;
            await updateCartQuantity(productId, quantity);
          });
        });
      });
    </script>
  </body>
</html>
